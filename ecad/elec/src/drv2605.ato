import Capacitor
import ElectricLogic
import ElectricPower
import I2C

from "dc_motor.ato" import DcMotor
from "parts/Texas_Instruments_DRV2605LDGSR/Texas_Instruments_DRV2605LDGSR.ato" import Texas_Instruments_DRV2605LDGSR_package

module Drv2605:
    """DRV2605L haptic motor driver (VSSOP-10), I2C controlled."""
    chip = new Texas_Instruments_DRV2605LDGSR_package
    power = new ElectricPower
    i2c = new I2C
    dc_motor = new DcMotor
    en = new ElectricLogic
    en.reference ~ power

    power.hv ~ chip.VDD
    power.hv ~ chip.VDD_NC
    power.lv ~ chip.GND
    i2c.sda.line ~ chip.SDA
    i2c.scl.line ~ chip.SCL
    dc_motor.a ~ chip.OUTpos
    dc_motor.b ~ chip.OUTneg
    en.line ~ chip.EN
    # I2C-trigger operation only: TI says ground IN/TRIG when unused
    chip.IN_TRIG ~ power.lv

    # supply decoupling
    vdd_cap = new Capacitor
    vdd_cap.capacitance = 100nF +/- 10%
    vdd_cap.package = "C0402"
    vdd_cap.unnamed[0] ~ chip.VDD
    vdd_cap.unnamed[1] ~ power.lv

    # internal regulator bypass (datasheet: 1uF on REG)
    reg_cap = new Capacitor
    reg_cap.capacitance = 1uF +/- 20%
    reg_cap.package = "C0402"
    reg_cap.unnamed[0] ~ chip.REG
    reg_cap.unnamed[1] ~ power.lv
