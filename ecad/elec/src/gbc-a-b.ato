import ElectricLogic
import ElectricPower

from "gbc-buttons.ato" import GbcABButton
from "parts/GBC_A_B_MEMBRANE/GBC_A_B_MEMBRANE.ato" import GBC_A_B_MEMBRANE_package

module GbcAB:
    """
    A and B buttons matching the Gameboy Color A/B membrane.
    Outputs are active-low with 10k pull-ups.
    """
    membrane = new GBC_A_B_MEMBRANE_package
    power = new ElectricPower

    a = new ElectricLogic
    b = new ElectricLogic

    a_btn = new GbcABButton
    b_btn = new GbcABButton

    power ~ a_btn.power
    power ~ b_btn.power

    a ~ a_btn.out
    b ~ b_btn.out
