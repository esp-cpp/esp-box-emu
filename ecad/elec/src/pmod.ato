import ElectricPower
import USB2_0

from "parts/PMOD_2X06_EDGE/PMOD_2X06_EDGE.ato" import PMOD_2X06_EDGE_package

module Pmod1:
    """PMOD 1 edge fingers of the ESP32-S3-BOX (usb + i2c side)."""
    conn = new PMOD_2X06_EDGE_package
    power = new ElectricPower
    usb2 = new USB2_0

    signal gnd ~ conn.p9
    gnd ~ conn.p10
    gnd ~ power.lv
    power.hv ~ conn.p11
    power.hv ~ conn.p12

    usb2.usb_if.d.n.line ~ conn.p5
    usb2.usb_if.d.p.line ~ conn.p7

    signal io42 ~ conn.p1
    signal io38 ~ conn.p2
    signal io21 ~ conn.p3
    signal io39 ~ conn.p4
    signal io40 ~ conn.p6
    signal io41 ~ conn.p8

module Pmod2:
    """PMOD 2 edge fingers of the ESP32-S3-BOX (spi side)."""
    conn = new PMOD_2X06_EDGE_package
    power = new ElectricPower

    signal gnd ~ conn.p9
    gnd ~ conn.p10
    gnd ~ power.lv
    power.hv ~ conn.p11
    power.hv ~ conn.p12

    signal io10 ~ conn.p1
    signal io9 ~ conn.p2
    signal io11 ~ conn.p3
    signal io43 ~ conn.p4
    signal io13 ~ conn.p5
    signal io44 ~ conn.p6
    signal io12 ~ conn.p7
    signal io14 ~ conn.p8
