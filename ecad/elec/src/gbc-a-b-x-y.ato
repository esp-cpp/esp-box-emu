import ElectricLogic
import ElectricPower

from "gbc-a-b.ato" import GbcAB

module GbcABXY:
    """
    A, B, X and Y buttons using two Gameboy Color A/B button groups.
    """
    power = new ElectricPower

    a = new ElectricLogic
    b = new ElectricLogic
    x = new ElectricLogic
    y = new ElectricLogic

    a_b_btns = new GbcAB
    x_y_btns = new GbcAB

    power ~ a_b_btns.power
    power ~ x_y_btns.power

    a ~ a_b_btns.a
    b ~ a_b_btns.b
    x ~ x_y_btns.a
    y ~ x_y_btns.b
