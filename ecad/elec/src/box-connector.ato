import ElectricLogic
import ElectricPower
import I2C
import SPI
import USB2_0

from "pmod.ato" import Pmod1, Pmod2
from "parts/BOX_EMU_OUTLINE/BOX_EMU_OUTLINE.ato" import BOX_EMU_OUTLINE_package
from "parts/PWR_2X02_EDGE/PWR_2X02_EDGE.ato" import PWR_2X02_EDGE_package

module BoxConnector:
    """
    Edge-finger interface to the ESP32-S3-BOX PMOD connectors, plus the
    board outline for the BOX variant.
    """
    outline = new BOX_EMU_OUTLINE_package

    pmod1 = new Pmod1
    pmod2 = new Pmod2
    pin2x2 = new PWR_2X02_EDGE_package

    # power rails
    power_3v3 = new ElectricPower
    power_5v = new ElectricPower
    signal gnd ~ power_3v3.lv
    gnd ~ power_5v.lv

    # interfaces
    usb2 = new USB2_0
    i2c = new I2C
    spi = new SPI
    spi_cs = new ElectricLogic
    io14 = new ElectricLogic

    # power
    gnd ~ pin2x2.p2
    gnd ~ pin2x2.p3
    power_5v.hv ~ pin2x2.p1
    power_5v.hv ~ pin2x2.p4
    power_3v3 ~ pmod1.power
    power_3v3 ~ pmod2.power

    # buses
    usb2 ~ pmod1.usb2
    i2c.sda.line ~ pmod1.io41
    i2c.scl.line ~ pmod1.io40
    i2c.sda.reference ~ power_3v3
    spi.miso.line ~ pmod2.io13
    spi.mosi.line ~ pmod2.io11
    spi.sclk.line ~ pmod2.io12
    spi.miso.reference ~ power_3v3
    spi_cs.line ~ pmod2.io10
    spi_cs.reference ~ power_3v3
    io14.line ~ pmod2.io14
    io14.reference ~ power_3v3
