import ElectricLogic
import ElectricPower

from "gbc-buttons.ato" import GbcDpadButton
from "parts/GBC_DPAD_MEMBRANE/GBC_DPAD_MEMBRANE.ato" import GBC_DPAD_MEMBRANE_package

module GbcDpad:
    """
    D-pad made from 4 carbon-pad buttons matching the Gameboy Color membrane.
    Outputs are active-low with 10k pull-ups.
    """
    membrane = new GBC_DPAD_MEMBRANE_package
    power = new ElectricPower

    up = new ElectricLogic
    down = new ElectricLogic
    left = new ElectricLogic
    right = new ElectricLogic

    up_button = new GbcDpadButton
    down_button = new GbcDpadButton
    left_button = new GbcDpadButton
    right_button = new GbcDpadButton

    power ~ up_button.power
    power ~ down_button.power
    power ~ left_button.power
    power ~ right_button.power

    up ~ up_button.out
    down ~ down_button.out
    left ~ left_button.out
    right ~ right_button.out
