import ElectricLogic
import ElectricPower

from "gbc-buttons.ato" import GbcStartSelectButton
from "parts/GBC_START_SELECT_MEMBRANE/GBC_START_SELECT_MEMBRANE.ato" import GBC_START_SELECT_MEMBRANE_package

module GbcStartSelect:
    """
    Start and select buttons matching the Gameboy Color start/select membrane.
    Outputs are active-low with 10k pull-ups.
    """
    membrane = new GBC_START_SELECT_MEMBRANE_package
    power = new ElectricPower

    start = new ElectricLogic
    select = new ElectricLogic

    start_btn = new GbcStartSelectButton
    select_btn = new GbcStartSelectButton

    power ~ start_btn.power
    power ~ select_btn.power

    start ~ start_btn.out
    select ~ select_btn.out
