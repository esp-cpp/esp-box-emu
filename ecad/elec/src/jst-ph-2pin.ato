import ElectricPower

from "parts/JST_Sales_America_S2B_PH_SM4_TB_LF__SN/JST_Sales_America_S2B_PH_SM4_TB_LF__SN.ato" import JST_Sales_America_S2B_PH_SM4_TB_LF__SN_package

module JstPHBattery:
    """JST-PH 2-pin battery connector (pin 1 = +, pin 2 = -)."""
    conn = new JST_Sales_America_S2B_PH_SM4_TB_LF__SN_package
    power = new ElectricPower

    power.hv ~ conn.1
    power.lv ~ conn.2
    # housing / retention pads
    power.lv ~ conn.3
    power.lv ~ conn.4
