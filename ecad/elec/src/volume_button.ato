import ElectricLogic
import ElectricPower
import Resistor

from "parts/SHOU_HAN_TS24CA/SHOU_HAN_TS24CA.ato" import SHOU_HAN_TS24CA_package

module VolumeButton:
    """
    Volume button using a right-angle tactile switch.
    Output is active-low with a 10k pull-up.
    """
    power = new ElectricPower
    out = new ElectricLogic
    out.reference ~ power

    btn = new SHOU_HAN_TS24CA_package
    pullup = new Resistor
    pullup.resistance = 10kohm +/- 5%
    pullup.package = "R0402"

    pullup.unnamed[0] ~ power.hv
    pullup.unnamed[1] ~ btn.1
    out.line ~ btn.1
    btn.2 ~ power.lv
    # shield / mounting pads to ground
    btn.3 ~ power.lv
    btn.4 ~ power.lv
