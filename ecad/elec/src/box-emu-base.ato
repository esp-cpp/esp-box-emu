import Capacitor
import ElectricLogic
import ElectricPower
import I2C
import Resistor

from "parts/BOX_EMU_BASE_OUTLINE/BOX_EMU_BASE_OUTLINE.ato" import BOX_EMU_BASE_OUTLINE_package
from "parts/Ckmtw_B_2100S02P_A110/Ckmtw_B_2100S02P_A110.ato" import Ckmtw_B_2100S02P_A110_package
from "parts/Guangdong_Hottech_1N5819WS/Guangdong_Hottech_1N5819WS.ato" import Guangdong_Hottech_1N5819WS_package
from "parts/Maxim_Integrated_MAX17048G_T10/Maxim_Integrated_MAX17048G_T10.ato" import Maxim_Integrated_MAX17048G_T10_package
from "parts/Microchip_Tech_MCP73831T_2ACI_OT/Microchip_Tech_MCP73831T_2ACI_OT.ato" import Microchip_Tech_MCP73831T_2ACI_OT_package
from "parts/Yongyu_Photoelectric_SZYY0805R/Yongyu_Photoelectric_SZYY0805R.ato" import Yongyu_Photoelectric_SZYY0805R_package

from "aw9523.ato" import Aw9523
from "dc_motor.ato" import DcMotor
from "drv2605.ato" import Drv2605
from "gbc-a-b-x-y.ato" import GbcABXY
from "gbc-dpad.ato" import GbcDpad
from "gbc-start-select.ato" import GbcStartSelect
from "jst-ph-2pin.ato" import JstPHBattery
from "microsd.ato" import MicroSdCardSpi
from "qwiic.ato" import QwiicConnector
from "tps63020.ato" import Tps63020Regulator
from "usb-c.ato" import UsbCConn
from "volume_button.ato" import VolumeButton

module MotorConnector:
    """1x2 header for the vibration motor."""
    conn = new Ckmtw_B_2100S02P_A110_package
    dc_motor = new DcMotor
    dc_motor.a ~ conn.1
    dc_motor.b ~ conn.2

module PowerDiode:
    """Schottky diode wrapped with power-in/power-out interfaces."""
    power_in = new ElectricPower
    power_out = new ElectricPower
    power_in.lv ~ power_out.lv

    diode = new Guangdong_Hottech_1N5819WS_package
    power_in.hv ~ diode.A
    diode.K ~ power_out.hv

module BoxEmuBase:
    """
    Main carrier board: battery power path, charger, fuel gauge, IO
    expander, buttons, haptics and micro-SD, shared by the BOX and BOX-3
    variants.
    """
    outline = new BOX_EMU_BASE_OUTLINE_package

    # ------------------------------------------------------------------
    # Power rails
    # ------------------------------------------------------------------
    power_3v3 = new ElectricPower
    power_3v3.voltage = 3.3V +/- 5%
    signal vcc_3v3 ~ power_3v3.hv
    vcc_3v3.override_net_name = "vcc_3v3"

    power_5v = new ElectricPower
    power_5v.voltage = 5V +/- 5%
    signal vcc_5v ~ power_5v.hv
    vcc_5v.override_net_name = "vcc_5v"

    power_bat = new ElectricPower
    power_bat.voltage = 3.0V to 4.2V
    signal vbat ~ power_bat.hv
    vbat.override_net_name = "vbat"

    power_usb = new ElectricPower
    power_usb.voltage = 5V +/- 5%
    signal vbus ~ power_usb.hv
    vbus.override_net_name = "vbus"

    # common ground for all power rails
    signal gnd ~ power_3v3.lv
    gnd ~ power_5v.lv
    gnd ~ power_bat.lv
    gnd ~ power_usb.lv
    gnd.override_net_name = "gnd"

    # battery connector
    bat_conn = new JstPHBattery
    power_bat ~ bat_conn.power

    # USB-C connector
    usb_c = new UsbCConn
    power_usb ~ usb_c.power

    # ------------------------------------------------------------------
    # I2C bus
    # ------------------------------------------------------------------
    i2c = new I2C
    i2c.sda.reference ~ power_3v3
    i2c_sda_pullup = new Resistor
    i2c_sda_pullup.resistance = 10kohm +/- 5%
    i2c_sda_pullup.package = "R0402"
    i2c_sda_pullup.unnamed[0] ~ power_3v3.hv
    i2c_sda_pullup.unnamed[1] ~ i2c.sda.line
    i2c_scl_pullup = new Resistor
    i2c_scl_pullup.resistance = 10kohm +/- 5%
    i2c_scl_pullup.package = "R0402"
    i2c_scl_pullup.unnamed[0] ~ power_3v3.hv
    i2c_scl_pullup.unnamed[1] ~ i2c.scl.line

    # qwiic connector for easy debugging
    qwiic = new QwiicConnector
    power_3v3 ~ qwiic.power
    i2c ~ qwiic.i2c

    # ------------------------------------------------------------------
    # IO expander (buttons -> I2C)
    # ------------------------------------------------------------------
    io = new Aw9523
    power_3v3 ~ io.power
    i2c ~ io.i2c

    # ------------------------------------------------------------------
    # 5V supply: TPS63020 buck-boost from the battery
    # ------------------------------------------------------------------
    tps63020 = new Tps63020Regulator
    power_bat ~ tps63020.power_in
    power_5v ~ tps63020.power_out
    # always enabled; regulator runs in power-save (PFM) mode so the
    # no-load drain on the battery stays in the tens of uA
    tps63020.enable.line ~ power_bat.hv

    # diode to allow VBUS to power the 5V rail in case the battery is
    # not present or is dead; bypasses the 5V regulator
    diode = new PowerDiode
    power_usb ~ diode.power_in
    diode.power_out ~ power_5v

    # ------------------------------------------------------------------
    # Battery charger
    # ------------------------------------------------------------------
    mcp73831 = new Microchip_Tech_MCP73831T_2ACI_OT_package
    power_usb.hv ~ mcp73831.VDD
    gnd ~ mcp73831.VSS
    power_bat.hv ~ mcp73831.VBAT
    # programming resistor: Iprog = 1000V / Rprog (2k = 500mA)
    charg_prog_res = new Resistor
    charg_prog_res.resistance = 2kohm +/- 5%
    charg_prog_res.package = "R0402"
    charg_prog_res.unnamed[0] ~ mcp73831.PROG
    charg_prog_res.unnamed[1] ~ gnd
    mcp73831_bypass = new Capacitor
    mcp73831_bypass.capacitance = 4.7uF +/- 10%
    mcp73831_bypass.package = "C0402"
    mcp73831_bypass.unnamed[0] ~ mcp73831.VDD
    mcp73831_bypass.unnamed[1] ~ gnd
    mcp73831_bypass_out = new Capacitor
    mcp73831_bypass_out.capacitance = 4.7uF +/- 10%
    mcp73831_bypass_out.package = "C0402"
    mcp73831_bypass_out.unnamed[0] ~ mcp73831.VBAT
    mcp73831_bypass_out.unnamed[1] ~ gnd

    # charging indicator: VBUS -> resistor -> LED -> STAT (STAT sinks
    # current while charging). Powered from VBUS so it can never drain
    # the battery.
    led_charge = new Yongyu_Photoelectric_SZYY0805R_package
    led_res = new Resistor
    led_res.resistance = 5.1kohm +/- 5%
    led_res.package = "R0402"
    power_usb.hv ~ led_res.unnamed[0]
    led_res.unnamed[1] ~ led_charge.pos
    led_charge.neg ~ mcp73831.STAT

    # ------------------------------------------------------------------
    # Battery fuel gauge
    # ------------------------------------------------------------------
    max17048 = new Maxim_Integrated_MAX17048G_T10_package
    max17048.VDD ~ power_bat.hv
    max17048.GND ~ gnd
    max17048.CELL ~ power_bat.hv
    max17048.QSTRT ~ gnd
    max17048.CTG ~ gnd
    max17048.EP ~ gnd
    max17048.SDA ~ i2c.sda.line
    max17048.SCL ~ i2c.scl.line
    max17048.nALRT ~ io.chip.P1_3
    # alert is open-drain; pull up to the io-expander rail
    max17048_alert_pullup = new Resistor
    max17048_alert_pullup.resistance = 10kohm +/- 5%
    max17048_alert_pullup.package = "R0402"
    max17048_alert_pullup.unnamed[0] ~ max17048.nALRT
    max17048_alert_pullup.unnamed[1] ~ power_3v3.hv
    max17048_bypass = new Capacitor
    max17048_bypass.capacitance = 100nF +/- 10%
    max17048_bypass.package = "C0402"
    max17048_bypass.unnamed[0] ~ max17048.VDD
    max17048_bypass.unnamed[1] ~ gnd

    # ------------------------------------------------------------------
    # Micro-SD card (SPI)
    # ------------------------------------------------------------------
    uSD = new MicroSdCardSpi
    uSD.power ~ power_3v3

    # bulk capacitance for the 3v3 rail: it arrives over the dock/edge
    # contacts, and SD write bursts would otherwise only see 100nF locally
    sd_bulk_cap = new Capacitor
    sd_bulk_cap.capacitance = 22uF +/- 20%
    sd_bulk_cap.package = "C0805"
    sd_bulk_cap.unnamed[0] ~ power_3v3.hv
    sd_bulk_cap.unnamed[1] ~ gnd

    # ------------------------------------------------------------------
    # Haptics
    # ------------------------------------------------------------------
    drv2605 = new Drv2605
    power_3v3 ~ drv2605.power
    i2c ~ drv2605.i2c
    # enable pulled up; software can only disable via I2C standby
    drv2605_en_pullup = new Resistor
    drv2605_en_pullup.resistance = 10kohm +/- 5%
    drv2605_en_pullup.package = "R0402"
    drv2605_en_pullup.unnamed[0] ~ drv2605.en.line
    drv2605_en_pullup.unnamed[1] ~ power_3v3.hv

    # motor connector (e.g. C17188262 rectangular LRA or C2682302 pancake ERM)
    motor_conn = new MotorConnector
    motor_conn.dc_motor ~ drv2605.dc_motor

    # ------------------------------------------------------------------
    # Buttons
    # ------------------------------------------------------------------
    dpad = new GbcDpad
    dpad.power ~ power_3v3
    dpad.up.line ~ io.chip.P0_0
    dpad.down.line ~ io.chip.P0_1
    dpad.left.line ~ io.chip.P0_2
    dpad.right.line ~ io.chip.P0_3
    dpad.up.line.override_net_name = "up"
    dpad.down.line.override_net_name = "down"
    dpad.left.line.override_net_name = "left"
    dpad.right.line.override_net_name = "right"

    buttons_abxy = new GbcABXY
    buttons_abxy.power ~ power_3v3
    buttons_abxy.a.line ~ io.chip.P0_4
    buttons_abxy.b.line ~ io.chip.P0_5
    buttons_abxy.x.line ~ io.chip.P0_6
    buttons_abxy.y.line ~ io.chip.P0_7
    # note: no override_net_name on a/b/x/y -- the x/y nets are internally
    # the second GbcAB's a/b, and forcing names collides with the suggested
    # net names derived from those field names

    start_select = new GbcStartSelect
    start_select.power ~ power_3v3
    start_select.start.line ~ io.chip.P1_0
    start_select.select.line ~ io.chip.P1_1
    start_select.start.line.override_net_name = "start"
    start_select.select.line.override_net_name = "select"

    vol_up = new VolumeButton
    vol_up.power ~ power_3v3
    vol_up.out.line ~ io.chip.P1_4
    vol_up.out.line.override_net_name = "vol_up"
    vol_down = new VolumeButton
    vol_down.power ~ power_3v3
    vol_down.out.line ~ io.chip.P1_5
    vol_down.out.line.override_net_name = "vol_down"

    # P1_6/P1_7 are the only unconnected expander pins. AW9523 inputs have
    # no internal pulls, so firmware must configure them as outputs at init
    # (pulldown resistors don't fit the congested region north of U2).

    # ------------------------------------------------------------------
    # Battery voltage measurement divider (VBAT/2 into an ADC pin).
    # 1M+1M instead of the previous 10k+10k: the old divider drained
    # ~200uA from the battery 24/7. The 100nF cap provides the sampling
    # charge for the ESP32 ADC despite the high source impedance.
    # ------------------------------------------------------------------
    battery_measurement = new ElectricLogic
    battery_measurement.reference ~ power_3v3
    battery_vdiv_top = new Resistor
    battery_vdiv_top.resistance = 1Mohm +/- 1%
    battery_vdiv_top.package = "R0402"
    battery_vdiv_bottom = new Resistor
    battery_vdiv_bottom.resistance = 1Mohm +/- 1%
    battery_vdiv_bottom.package = "R0402"
    battery_vdiv_cap = new Capacitor
    battery_vdiv_cap.capacitance = 100nF +/- 10%
    battery_vdiv_cap.package = "C0402"
    power_bat.hv ~ battery_vdiv_top.unnamed[0]
    battery_vdiv_top.unnamed[1] ~ battery_measurement.line
    battery_measurement.line ~ battery_vdiv_bottom.unnamed[0]
    battery_vdiv_bottom.unnamed[1] ~ gnd
    battery_vdiv_cap.unnamed[0] ~ battery_measurement.line
    battery_vdiv_cap.unnamed[1] ~ gnd
    battery_measurement.line.override_net_name = "battery_measurement"
