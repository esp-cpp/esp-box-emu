# Keep prboom's static state out of internal DRAM.
#
# prboom has ~9KB of .bss/COMMON (menu/intermission state, renderer tables,
# etc.) that would otherwise occupy internal RAM for every emulator, including
# the ones that need every internal byte they can get (the Genesis keeps its
# 64KB work RAM and VDP VRAM internal when it can). Doom itself streams most of
# its data from PSRAM already, so moving its statics there is not measurable.
# Requires CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY.
[scheme:doom_psram_bss]
entries:
    bss -> extern_ram
    common -> extern_ram

[mapping:doom]
archive: libdoom.a
entries:
    * (doom_psram_bss)
